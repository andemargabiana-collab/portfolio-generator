<% layout('layout') -%>

<section class="hero">
  <h1>DevFolio</h1>
  <p>Create and publish your portfolio: enter your information, save it to an online database, choose one of 3 templates, and generate a shareable portfolio.</p>
  <a class="btn primary" href="/portfolios/create">Create Portfolio</a>
</section>

<section class="feature-grid">
  <div class="feature-card">
    <h3>Portfolio Information</h3>
    <p>Store personal details, education, skills, projects, and experience.</p>
  </div>

  <div class="feature-card">
    <h3>3 Templates</h3>
    <p>Choose between Simple, Modern, and Creative layouts.</p>
  </div>

  <div class="feature-card">
    <h3>Manage & Share</h3>
    <p>Preview, edit, delete, or share the generated portfolio online.</p>
  </div>
</section>
