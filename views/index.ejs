<% layout('layout') -%>
<section class="hero">
  <h2>Build your professional portfolio with DevFolio</h2>
  <p>Enter your information, choose one of three templates, and generate a shareable portfolio hosted online.</p>
  <a class="btn primary" href="/portfolios/create">Create Portfolio</a>
</section>

<section class="overview">
  <h3>What DevFolio does</h3>
  <ul>
    <li>Save personal info, education, skills, projects, and experience to an online database.</li>
    <li>Choose between 3 distinct templates (Simple, Modern, Creative).</li>
    <li>Preview, edit, and delete portfolios. Share a public portfolio link.</li>
  </ul>
</section>

<section class="requirements">
  <h3>Quick checklist</h3>
  <ol>
    <li>Create portfolio & enter information</li>
    <li>Save to online database (MongoDB Atlas)</li>
    <li>Select template and preview</li>
    <li>Edit or delete as needed</li>
  </ol>
</section>
